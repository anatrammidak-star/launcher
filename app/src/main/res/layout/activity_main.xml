<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_amoled"
    android:paddingStart="24dp"
    android:paddingEnd="8dp">

    <!-- Jam & Tanggal -->
    <LinearLayout
        android:id="@+id/headerClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/textClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format24Hour="HH:mm"
            android:format12Hour="hh:mm"
            android:textColor="@color/text_primary"
            android:textSize="48sp"
            android:fontFamily="sans-serif-light" />

        <TextClock
            android:id="@+id/textDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format24Hour="EEEE, d MMMM"
            android:format12Hour="EEEE, d MMMM"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- 4 Ikon Favorit Horisontal (24dp) -->
    <LinearLayout
        android:id="@+id/favContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerClock"
        android:layout_marginTop="32dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/favWhatsApp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="20dp"
            android:tint="@color/text_primary"
            android:contentDescription="WhatsApp" />

        <ImageView
            android:id="@+id/favMaps"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="20dp"
            android:tint="@color/text_primary"
            android:contentDescription="Maps" />

        <ImageView
            android:id="@+id/favChrome"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="20dp"
            android:tint="@color/text_primary"
            android:contentDescription="Chrome" />

        <ImageView
            android:id="@+id/favGallery"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:tint="@color/text_primary"
            android:contentDescription="Gallery" />
    </LinearLayout>

    <!-- Daftar Aplikasi Terpilih -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvApps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/favContainer"
        android:layout_toStartOf="@id/rulerSlider"
        android:layout_marginTop="28dp"
        android:overScrollMode="never" />

    <!-- Custom View Navigasi Penggaris A-Z -->
    <com.minimal.rulerlauncher.RulerSliderView
        android:id="@+id/rulerSlider"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="30dp" />

</RelativeLayout>
