<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_amoled"
    android:paddingStart="24dp"
    android:paddingEnd="16dp">

    <!-- Jam & Tanggal di Kiri Atas -->
    <LinearLayout
        android:id="@+id/headerClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/textClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format24Hour="HH:mm"
            android:format12Hour="hh:mm"
            android:textColor="@color/text_primary"
            android:textSize="46sp"
            android:fontFamily="sans-serif-light" />

        <TextClock
            android:id="@+id/textDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format24Hour="EEEE, d MMMM"
            android:format12Hour="EEEE, d MMMM"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- 4 Slot Ikon Favorit Horizontal -->
    <LinearLayout
        android:id="@+id/favContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerClock"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/favWhatsApp"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="20dp"
            android:contentDescription="Fav 1" />

        <ImageView
            android:id="@+id/favMaps"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="20dp"
            android:contentDescription="Fav 2" />

        <ImageView
            android:id="@+id/favChrome"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="20dp"
            android:contentDescription="Fav 3" />

        <ImageView
            android:id="@+id/favGallery"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="Fav 4" />
    </LinearLayout>

    <!-- Daftar Aplikasi di Sisi Kanan (Dari Atas ke Bawah) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvApps"
        android:layout_width="220dp"
        android:layout_height="match_parent"
        android:layout_below="@id/favContainer"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="60dp"
        android:overScrollMode="never" />

    <!-- Penggaris Horizontal Bersih di Bagian Bawah -->
    <com.minimal.rulerlauncher.HorizontalRulerView
        android:id="@+id/horizontalRuler"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="12dp" />

</RelativeLayout>
